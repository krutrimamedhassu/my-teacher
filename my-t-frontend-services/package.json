{
  "name": "myteacher-dev",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.13.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.81.2",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "katex": "^0.16.22",
    "lucide-react": "^0.523.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-flow-renderer": "^10.3.17",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.11.1",
    "react-scripts": "5.0.1",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^2.1.4",
    "wouter": "^3.7.1"
  },
  "scripts": {
    "start": "HOST=0.0.0.0 PORT=9100 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pre-push": "npm run build && npm run lint && npm run check-deps",
    "lint": "eslint src/ --ext .js,.jsx",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "check-deps": "npm audit --audit-level moderate",
    "check-all": "npm run lint && npm run build && npm run check-deps"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "no-unused-expressions": "warn",
      "prefer-const": "warn",
      "no-console": "off",
      "react/no-unused-prop-types": "warn",
      "react/jsx-no-duplicate-props": "error",
      "react/jsx-key": "error",
      "react/no-array-index-key": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6"
  },
  "proxy": "http://127.0.0.1:9150"
}
